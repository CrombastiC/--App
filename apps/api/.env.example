# Environment
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orderfood?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=5000
API_PREFIX="api"

# File Upload
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=10485760

# ==================== 支付宝沙箱支付 ====================
# 支付宝 AppId（沙箱环境，从 English 项目复制）
ALIPAY_APP_ID="9021000138654788"

# 支付宝沙箱网关地址
ALIPAY_GATEWAY="https://openapi-sandbox.dl.alipaydev.com/gateway.do"

# 支付宝应用私钥（从 English 项目 /server/.env 复制 ALIPAY_PRIVATE_KEY 的值）
ALIPAY_PRIVATE_
#支付宝公钥

# 支付宝公钥（从 English 项目 /server/.env 复制 ALIPAY_PUBLIC_KEY 的值）
ALIPAY_PUBLIC_KEY=''

# 支付宝异步通知回调地址（需要公网可访问，用 cpolar/ngrok 穿透后替换）
# 回调地址格式：{ALIPAY_NOTIFY_URL}/api/v1/pay/notify
ALIPAY_NOTIFY_URL="http://448367a7.r29.cpolar.top"
